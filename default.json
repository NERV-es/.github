{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Shared Renovate preset for all NERV-es forks. Extend with: { \"extends\": [\"github>NERV-es/.github\"] }",
  "extends": [
    "config:recommended",
    ":dependencyDashboard",
    ":semanticCommits",
    "group:allNonMajor",
    "schedule:weekly"
  ],
  "labels": ["dependencies"],
  "prConcurrentLimit": 10,
  "prHourlyLimit": 4,
  "packageRules": [
    {
      "description": "Auto-merge patch and minor updates once checks pass",
      "matchUpdateTypes": ["patch", "minor"],
      "automerge": true
    }
  ],
  "github-actions": {
    "pinDigests": true
  }
}